# 本地运行时复制为 .env 并填写；线上运行时这些值放在 GitHub 仓库的 Settings → Secrets and variables → Actions

# 卖家精灵 MCP 密钥：https://open.sellersprite.com → 获取密钥（与 AI工作台 用同一个 key 时，两边共享积分）
SELLERSPRITE_SECRET_KEY=
# 可选：覆盖 MCP 地址
# SELLERSPRITE_MCP_URL=https://mcp.sellersprite.com/mcp

# 报告/数据加密主密钥（32 字节 base64url）。生成：python -m radar keygen
# 务必备份！丢失后历史数据和旧报告都无法解密。
REPORT_KEY=

# 钉钉群机器人 webhook 与加签密钥；多个群用英文逗号分隔，按顺序一一对应
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
# 也可以每个群单独写一行（推荐，新增群不用改上面两行）：名字以 DINGTALK_ROBOT_ 开头，值为“webhook,SEC密钥”
# DINGTALK_ROBOT_TEAM=https://oapi.dingtalk.com/robot/send?access_token=xxx,SECxxx

# 可选：DeepSeek（或任何 OpenAI 兼容接口）用于生成文字总结；不填则使用模板文字
DEEPSEEK_API_KEY=

# 可选：报告网址前缀，默认 https://<GitHub用户名>.github.io/<仓库名>/
REPORT_BASE_URL=
